<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:fitsSystemWindows="true">

    <!-- ============================ main content ============================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:navigationContentDescription="@string/nav_drawer_open"
                    app:navigationIcon="@drawable/ic_menu_24"
                    app:title=""
                    app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

                <LinearLayout
                    android:id="@+id/crumbBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btnUp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_open"
                        android:src="@drawable/ic_arrow_back" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/crumbRecycler"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- ============================== drawer ================================ -->
    <LinearLayout
        android:id="@+id/drawerRoot"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/ui_surface"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="16dp">

                <!-- header: app logo + name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_logo_tile"
                        android:contentDescription="@string/app_name"
                        android:padding="10dp"
                        android:src="@mipmap/ic_launcher_foreground"
                        app:tint="@android:color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/ui_ink"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDrawerVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/ui_muted" />
                    </LinearLayout>
                </LinearLayout>

                <!-- storage group -->
                <TextView
                    style="@style/DrawerGroupLabel"
                    android:text="@string/nav_storage" />

                <LinearLayout
                    android:id="@+id/drowHome"
                    style="@style/DrawerRow"
                    android:background="@drawable/bg_drawer_row_on">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_home_24"
                        app:tint="@color/ui_accent" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/drawer_home"
                        android:textColor="@color/ui_accent"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drowInternal"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_storage"
                        app:tint="@color/ui_ink2" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/drawer_internal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drowSd"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_sd_24"
                        app:tint="@color/ui_ink2" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/drawer_sd" />
                </LinearLayout>

                <!-- categories group -->
                <TextView
                    style="@style/DrawerGroupLabel"
                    android:text="@string/nav_categories" />

                <LinearLayout
                    android:id="@+id/drowImages"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_image"
                        app:tint="@color/file_image" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/cat_images" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drowVideos"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_video"
                        app:tint="@color/file_video" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/cat_videos" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drowAudio"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_audio"
                        app:tint="@color/file_audio" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/cat_audio" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drowDocs"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_doc"
                        app:tint="@color/file_doc" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/cat_documents" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drowArchives"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_archive"
                        app:tint="@color/file_archive" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/cat_archives" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drowApks"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_apk"
                        app:tint="@color/file_apk" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/cat_apk" />
                </LinearLayout>

                <!-- library group -->
                <TextView
                    style="@style/DrawerGroupLabel"
                    android:text="@string/nav_library" />

                <LinearLayout
                    android:id="@+id/drowFavorites"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_star"
                        app:tint="@color/brand_accent" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/lib_chip_favorites" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drowRecents"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_history"
                        app:tint="@color/ui_ink2" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/lib_chip_recent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drowDownloads"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_download"
                        app:tint="@color/file_sheet" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/lib_chip_downloads" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drowTrash"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/file_pdf" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/trash_chip" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drowVault"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_locked_folder"
                        app:tint="@color/ui_ink2" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/nav_vault" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drowSettings"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/ui_ink2" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/action_settings" />
                </LinearLayout>

                <!-- storage meter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_storage_meter"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drawer_internal"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/ui_ink"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDrawerUsed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/ui_ink2" />

                        <TextView
                            android:id="@+id/tvDrawerPct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/ui_muted" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbDrawerStorage"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progressTint="@color/ui_accent"
                        android:progressBackgroundTint="@color/ui_chip_bg" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDrawerFree"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/ui_muted" />
                    </LinearLayout>
                </LinearLayout>

                <!-- dark mode row -->
                <LinearLayout
                    android:id="@+id/drowDark"
                    style="@style/DrawerRow"
                    android:layout_marginTop="10dp">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:src="@drawable/ic_dark_mode"
                        app:tint="@color/ui_ink2" />

                    <TextView
                        style="@style/DrawerRowLabel"
                        android:text="@string/drawer_dark_mode" />

                    <Switch
                        android:id="@+id/swDark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
