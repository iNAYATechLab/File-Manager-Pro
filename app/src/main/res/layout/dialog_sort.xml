<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/action_sort"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <RadioGroup
        android:id="@+id/rgSort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_sort_name" />

        <RadioButton
            android:id="@+id/rbDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_sort_date" />

        <RadioButton
            android:id="@+id/rbSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_sort_size" />

        <RadioButton
            android:id="@+id/rbType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_sort_type" />

        <RadioButton
            android:id="@+id/rbExt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_sort_ext" />

        <RadioButton
            android:id="@+id/rbCreated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_sort_created" />
    </RadioGroup>

    <RadioGroup
        android:id="@+id/rgOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbAsc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_sort_asc" />

        <RadioButton
            android:id="@+id/rbDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_sort_desc" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="View"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <RadioGroup
        android:id="@+id/rgView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbListView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_view_list" />

        <RadioButton
            android:id="@+id/rbGridView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_view_grid" />
    </RadioGroup>

    <CheckBox
        android:id="@+id/chkFoldersFirst"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/sort_folders_first" />
</LinearLayout>
