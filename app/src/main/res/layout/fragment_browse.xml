<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <HorizontalScrollView
        android:id="@+id/quickAccessBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHomeFavorites"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lib_chip_favorites"
                app:chipIcon="@drawable/ic_star" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHomeRecents"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/lib_chip_recent"
                app:chipIcon="@drawable/ic_history" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHomeDownloads"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/lib_chip_downloads"
                app:chipIcon="@drawable/ic_download" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHomeTrash"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/trash_chip"
                app:chipIcon="@drawable/ic_delete" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Mockup .vrow: list/grid segmented control, sort, up one level. -->
    <LinearLayout
        android:id="@+id/viewRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/segWrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="2dp">

            <ImageButton
                android:id="@+id/btnList"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_seg_btn"
                android:contentDescription="@string/action_view_list"
                android:src="@drawable/ic_list_view"
                app:tint="@color/seg_icon_tint" />

            <ImageButton
                android:id="@+id/btnGrid"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_seg_btn"
                android:contentDescription="@string/action_view_grid"
                android:src="@drawable/ic_grid_view"
                app:tint="@color/seg_icon_tint" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSort"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/action_sort"
            android:textAllCaps="false"
            android:textColor="@color/ui_ink2"
            android:textSize="12sp"
            app:icon="@drawable/ic_sort"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="@color/ui_ink2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/action_up"
            android:textAllCaps="false"
            android:textColor="@color/ui_ink2"
            android:textSize="12sp"
            app:icon="@drawable/ic_chevron_up"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="@color/ui_ink2" />
    </LinearLayout>

    <include
        android:id="@+id/selectionBar"
        layout="@layout/view_selection_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="72dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/folder_empty"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
