<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         Reusable widget styles for the drawer and general surfaces.
         Colors come from ui_* tokens, so these styles are mode-agnostic.
         ============================================================ -->

    <style name="DrawerGroupLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="DrawerRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_drawer_row</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="DrawerRowIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Trailing count pill on a drawer row (mockup .ditem .ch). Hidden
         until the background scan reports a number for that category. -->
    <style name="DrawerRowCount">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_count_badge</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="DrawerRowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ui_ink2</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ============================================================
         Quick-access / category filter chips (mockup drawer row):
         unchecked = hairline outline + muted icon, checked = accent-soft
         pill with accent label, 12dp radius to match the mockup rows.
         ============================================================ -->

    <style name="Widget.App.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_filter_bg</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipIconTint">@color/chip_filter_icon</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- ============================================================
         Toast/snackbar — every transient message in the app (open,
         rename, share, undo, …) picks these up through the theme, so
         no call site has to change. Matches the mockup `.toast` pill:
         solid dark surface, white 13sp label, 12dp radius, floating.
         ============================================================ -->

    <style name="Widget.App.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/ui_snack_bg</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Snackbar</item>
        <item name="android:layout_margin">16dp</item>
    </style>

    <style name="ShapeAppearance.App.Snackbar" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.App.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.App.Snackbar.Button" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@android:color/white</item>
    </style>
</resources>
