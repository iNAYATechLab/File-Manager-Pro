<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base theme. All colors come from the ui_* design tokens in
         colors.xml, which swap automatically to their values-night twins,
         so this single style serves both light and dark. -->
    <style name="Theme.FileManagerPro" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Accent (mockup accent / accent-soft / accent-dark) -->
        <item name="colorPrimary">@color/ui_accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/ui_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/ui_accent_dark</item>
        <item name="colorSecondary">@color/ui_accent_dark</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorTertiary">@color/brand_accent</item>

        <!-- Surfaces (mockup bg / surface / surface2) -->
        <item name="colorSurface">@color/ui_surface</item>
        <item name="colorOnSurface">@color/ui_ink</item>
        <item name="colorOnSurfaceVariant">@color/ui_ink2</item>
        <item name="colorSurfaceVariant">@color/ui_surface2</item>
        <item name="colorSurfaceContainerLowest">@color/ui_bg</item>
        <item name="colorSurfaceContainerLow">@color/ui_surface2</item>
        <item name="colorSurfaceContainer">@color/ui_surface</item>
        <item name="colorSurfaceContainerHigh">@color/ui_surface</item>
        <item name="android:colorBackground">@color/ui_bg</item>
        <item name="android:windowBackground">@color/ui_bg</item>

        <!-- Hairlines (mockup line) -->
        <item name="colorOutline">@color/ui_line</item>
        <item name="colorOutlineVariant">@color/ui_line</item>

        <!-- System bars: transparent status, bg nav bar, dark icons in light -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ui_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Splash screen (1.0.0 hardening, #22). System splash on Android 12+,
         core-splashscreen backport below. -->
    <style name="Theme.FileManagerPro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.FileManagerPro</item>
    </style>

    <style name="TextAppearance.Crumb" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
